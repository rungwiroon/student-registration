# Required for production docker-compose.yml
# Copy this file to .env and fill in real values before deploying.
CONNECTION_STRING=Data Source=/app/data/csrapi.db;Password=REPLACE_WITH_STRONG_PASSWORD;
ENCRYPTION_KEY=REPLACE_WITH_32_CHAR_MINIMUM_KEY
LINE_LIFF_CHANNEL_ID=REPLACE_WITH_CHANNEL_ID
LINE_CHANNEL_ACCESS_TOKEN=REPLACE_WITH_CHANNEL_ACCESS_TOKEN

# Frontend build args
VITE_LIFF_ID=REPLACE_WITH_LIFF_ID
VITE_USE_MOCK_LIFF=false

# Optional: enable mock auth for local development
LINE_USE_MOCK_AUTH=false
LINE_MOCK_USER_ID=

# One-time bootstrap token for creating the first Teacher
BOOTSTRAP_SECRET_TOKEN=REPLACE_WITH_RANDOM_SECRET

# School Shirt Order — Google Sheets integration
GOOGLE_CLOUD_CREDENTIALS_PATH=/app/credentials/google-service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=REPLACE_WITH_SPREADSHEET_ID
SHIRT_ORDER_SLIP_PATH=/app/data/ShirtOrderSlips
